# OS / editor junk
Thumbs.db
desktop.ini
.DS_Store
*.log
*.tmp

# local runtime leftovers
node_modules/

# project memory (local working notes)
memory/

# local machine tooling kept outside the index (a scheduled task points at
# tools/clash-sync/run-hidden.vbs, so the directory stays where it is)
tools/

# research notes stay local: they quote device logs, session ids and local
# paths, so they must never reach the remote
research/

# secrets and signing keys never belong in the index
*.pem
.env
